{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb", "runtime": "python3.11" }
    },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/public/index.html" },
    { "src": "/(health|chart|transits|solar_return|progressions|lunar_return|cross|symbolic_directions|arabic_parts|midpoints|harmonic|armc|primary_directions|rectify|dignities|astrocartography|fixed_stars|eclipses_and_lunations)", "dest": "/api/index.py" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
